{
  "name": "commersync",
  "version": "1.0.0",
  "description": "CommerSync enterprise ecommerce monorepo",
  "engines": {
    "node": ">=22.16.0 <23",
    "pnpm": ">=10.0.0"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.48.0",
    "@typescript-eslint/parser": "^8.48.0",
    "eslint": "^9.0.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.3.0",
    "tsx": "^4.20.6",
    "turbo": "^2.6.1",
    "typescript": "^5.5.0"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint -- --fix",
    "lint:strict": "eslint --max-warnings 0 \"**/*.{ts,tsx,js,jsx}\"",
    "lint:changed": "git diff --name-only --diff-filter=ACMRTUXB main | grep -E \"\\.(ts|tsx|js|jsx)$\" | xargs -r eslint",
    "lint:ci": "eslint --max-warnings 0 \"**/*.{ts,tsx,js,jsx}\"",
    "test": "turbo run test",
    "clean": "turbo run clean",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yaml,yml}\"",
    "prepare": "husky",
    "postinstall": "husky",
    "typecheck": "turbo run typecheck"
  },
  "pnpm": {
    "overrides": {
      "react": "19.2.0",
      "react-dom": "19.2.0",
      "@types/react": "^19",
      "@types/react-dom": "^19",
      "@mui/material": "^7.3.6",
      "@mui/icons-material": "^7.3.6",
      "@emotion/react": "^11.14.0",
      "@emotion/styled": "^11.14.1"
    }
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "keywords": [
    "ecommerce",
    "nextjs",
    "monorepo",
    "turborepo"
  ],
  "author": "Tarun Sharma",
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@10.23.0"
}
